# Qalam Policy Command Centre: ONE config file for backend and frontend.
# Copy to .env (scripts\setup.ps1 does this) and fill in ANTHROPIC_API_KEY. Never commit .env.

# ---- Answer mode ----
# offline   = FREE: answers only from kb/data/*.json + verbatim document passages. No API key, no LLM calls.
# auto      = anthropic when ANTHROPIC_API_KEY is set, otherwise offline
# anthropic = Claude-generated, citation-verified answers (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_ROUTER_MODEL=claude-haiku-5-5

# ---- Retrieval ----
# bge-m3 (~2.3 GB) and the reranker (~2.3 GB) download once on first use.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# "No supporting source" thresholds; calibrate with scripts\eval.ps1
MIN_RERANK_SCORE=0.15
MIN_DENSE_SCORE=0.45

# Offline matching thresholds (0..1) and semantic search (auto = use bge-m3 only if already downloaded)
OFFLINE_MIN_SCORE=0.45
EXTRACTIVE_MIN_SCORE=0.6
OFFLINE_DENSE=auto

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---- Frontend (only VITE_* variables reach the browser) ----
VITE_API_URL=http://localhost:8000
VITE_MOCK=false
VITE_BASE=/
